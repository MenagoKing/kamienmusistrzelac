# Copy to .env (git-ignored) or set in your host's environment. Never commit real values.

# Admin panel password (/admin). Without it, a random one is generated on first start
# into data/admin-password.txt.
ADMIN_PASSWORD=

# Production server port (npm start).
PORT=3000

# Where the SQLite database and uploaded photos live. Default: ./data
DATA_DIR=

# Set to 1 only when serving production over plain http (cookies are Secure otherwise).
INSECURE_COOKIES=

# Sign in with Google: the public OAuth client ID (also settable in Admin › Rules & settings).
GOOGLE_CLIENT_ID=

# NFTs: devnet (default), testnet or mainnet-beta. CHAIN=simulated skips the network (tests).
SOLANA_CLUSTER=devnet
SOLANA_RPC=
# The vault authority keypair as a JSON array of 64 numbers. Default: generated into data/solana-authority.json.
SOLANA_AUTHORITY=
# Public address of the site, used in each NFT's metadata URI (e.g. https://spacerocks.example).
PUBLIC_URL=
CHAIN=
