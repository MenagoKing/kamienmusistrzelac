# Copy to .env (git-ignored) or set in your host's environment. Never commit real values.

# Admin panel password (/admin). Without it, a random one is generated on first start
# into data/admin-password.txt.
ADMIN_PASSWORD=

# Production server port (npm start).
PORT=3000

# Where the SQLite database and uploaded photos live. Default: ./data
DATA_DIR=

# Set to 1 only when serving production over plain http (cookies are Secure otherwise).
INSECURE_COOKIES=

# Sign in with Google: the public OAuth client ID (also settable in Admin › Rules & settings).
GOOGLE_CLIENT_ID=

# NFTs: devnet (default), testnet or mainnet-beta. CHAIN=simulated skips the network (tests).
# The network the site starts on before Admin › Network picks one: devnet (default) or mainnet-beta.
# CHAIN=simulated skips Solana entirely (tests).
SOLANA_CLUSTER=devnet
CHAIN=
# Public address of the site, used in each NFT's metadata URI (e.g. https://spacerocks.example).
PUBLIC_URL=

# Devnet: RPC, vault keypair (JSON array of 64 numbers; default data/solana-authority.json),
# encryption key for account wallets (64 hex characters; default data/custody-key.bin).
SOLANA_RPC=
SOLANA_AUTHORITY=
CUSTODY_KEY=

# Mainnet: the same, kept apart (defaults live in data/mainnet/). Use a dedicated RPC (Helius,
# Triton, QuickNode) and keep CUSTODY_KEY_MAINNET backed up offline.
SOLANA_RPC_MAINNET=
SOLANA_AUTHORITY_MAINNET=
CUSTODY_KEY_MAINNET=
# Allow collectors to export their wallet key on mainnet (off unless set to 1).
ALLOW_KEY_EXPORT=
