{
  "name": "space-rocks-site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "seed": "node server/seed-cli.ts",
    "test": "node server/smoke-test.ts",
    "chain:check": "node --env-file-if-exists=.env server/chain-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "6.4.6"
  }
}
